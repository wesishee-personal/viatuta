# Copy to web/.env — which is gitignored. Everything here is compiled into the
# public browser bundle, so treat this file as public configuration, not as a
# place for secrets.

# A PUBLIC Mapbox token. It MUST start with pk.
#
# You cannot hide this value: the browser sends it to Mapbox on every tile
# request, and proxying tiles through our own server to conceal it is
# prohibited by Mapbox's terms. Protect it in the dashboard instead:
#
#   1. Create a token for this app rather than using the account's default
#      token — the default cannot be scope-limited or URL-restricted.
#   2. Keep only the default public scopes (styles:tiles, styles:read,
#      fonts:read). Nothing here needs more.
#   3. Add URL restrictions: http://localhost:5173 for development, plus each
#      deployed origin. A token with no URL restriction works from anyone's
#      site, billed to you.
#   4. Use separate tokens for development and production so revoking one
#      does not take down the other.
#
# A secret (sk.) token here is refused by the build, not merely warned about.
VITE_MAPBOX_TOKEN=pk.your_token_here

# Only needed for a deployed build served from a different origin than the API.
# In development the Vite proxy handles this and you can leave it unset.
# VITE_API_BASE=https://api.example.com
