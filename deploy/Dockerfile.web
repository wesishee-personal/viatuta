# syntax=docker/dockerfile:1

# Builds the Vite app and bakes it into a Caddy image together with the
# production Caddyfile. VITE_ values are inlined into the public bundle, so
# only public (pk.) Mapbox tokens belong here — vite.config.ts rejects sk.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG VITE_MAPBOX_TOKEN=""
ENV VITE_MAPBOX_TOKEN=$VITE_MAPBOX_TOKEN
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
