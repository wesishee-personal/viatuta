# Production edge: terminates TLS (Let's Encrypt, automatic), serves the
# built web app, and forwards API traffic to the api container.
{$SITE_ADDRESS:viatuta.wesishee.com} {
	encode zstd gzip

	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
